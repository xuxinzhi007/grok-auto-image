{
  "manifest_version": 3,
  "name": "Grok 批量下载图片",
  "version": "1.1.0",
  "description": "在 grok.com/files 支持勾选下载与批量下载 assets.grok.com 图片，含进度与取消。",
  "icons": {
    "128": "icons/icon.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "notifications",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://assets.grok.com/*"
  ],
  "action": {
    "default_title": "打开 Grok 批量下载",
    "default_icon": "icons/icon.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/files*", "https://www.grok.com/files*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
