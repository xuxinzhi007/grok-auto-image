{
  "manifest_version": 3,
  "name": "Grok 批量下载图片",
  "version": "1.1.0",
  "description": "在 grok.com/files 一键滚动加载并批量下载 assets.grok.com 图片，支持进度与取消。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://assets.grok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "批量下载 Grok 图片",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/files*", "https://www.grok.com/files*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
